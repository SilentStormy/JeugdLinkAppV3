@page
@model JeugdLinkApp.Pages.SearchResultModel
@{
    ViewData["Title"] = "Zoekresultaten";
}

<h1 class="text-center my-4">Zoekresultaten</h1>

<div class="container">
    <div class="tab-content">
        <div class="tab-pane fade show active">
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
                @if (Model.SearchedCourses != null && Model.SearchedCourses.Any())
                {
                    @foreach (var course in Model.SearchedCourses)
                    {
                        <div class="col mb-4">
                            <div class="card shadow-sm h-100">
                                <img src="~/@course.courseimage" class="card-img-top" alt="@course.title" style="max-height: 200px; object-fit: cover;">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@course.title</h5>
                                    <p class="card-text text-truncate">@course.description</p>
                                    <p class="text-muted mb-3">Begint op: @course.startdate.ToString("dd-MM-yyyy")</p>
                                    <a asp-page="/Cursus" asp-route-id="@course.courseid" class="btn btn-primary mt-auto">Bekijk cursus</a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-center">Geen cursussen gevonden voor jouw zoekopdracht.</p>
                }
            </div>
        </div>
    </div>
</div>