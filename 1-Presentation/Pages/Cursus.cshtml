@page "{id:int}"
@model JeugdLinkApp.Pages.CursusModel
@{
    
}
<div class="container mt-5">
    
        <img src="~/@Model.course.courseimage" class="card-img-top img-fluid rounded" alt="@Model.course.title">
        <div class="card-body">
            <h1 class="card-title">@Model.course.title</h1>
            <p class="card-text">@Model.course.description</p>
        
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <form method="post" class="text-center">
        <input type="hidden" asp-for="@Model.course.courseid" />
        <button type="submit" asp-page-handler="Enroll" class="btn btn-primary btn-lg">
            Inschrijven
        </button>
    </form>
</div>
