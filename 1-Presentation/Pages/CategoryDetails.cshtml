<h1>Category Details</h1>
<p>Category ID: @Model.CategoryId</p>


<h2>Cursussen voor categorie: @Model.selectedCategory.name</h2>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
    @if (Model.CourseByCategory != null && Model.CourseByCategory.Any())
    {
        @foreach (var course in Model.CourseByCategory)
        {
            <div class="col mb-4">
                <div class="card shadow-sm">
                    <img src="~/@course.courseimage" class="card-img-top" alt="@course.title">
                    <div class="card-body">
                        <h5 class="card-title">@course.title</h5>
                        <p class="card-text">@course.description</p>
                        <p class="text-muted">Begint op: @course.startdate.ToString("dd-MM-yyyy")</p>
                        <a asp-page="/Cursus" asp-route-id="@course.courseid" class="btn btn-primary">Bekijk cursus</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-center">Geen cursussen beschikbaar voor deze categorie.</p>
    }
</div>
